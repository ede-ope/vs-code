{
  	"scopeName": "source.kui",
  	"name": "Kui",
  	"fileTypes": ["kui"],
  	"patterns": [
		{ "include": "#imports" },
		{ "include": "#mods" },
		{ "include": "#modEntries" },
    	{ "include": "#comments" },
    	{ "include": "#strings" },
    	{ "include": "#numbers" },
    	{ "include": "#keywords" },
	  	{ "include": "#specKeywords" },
    	{ "include": "#types" },
		{ "include": "#boolLiterals" },
		{ "include": "#classIdentifiers" },
		{ "include": "#enumDecls" },
	  	{ "include": "#declKeywords" },
		{ "include": "#tyIdentifiers" },
		{ "include": "#macros" },
	  	{ "include": "#funcIdentifiers" },
    	{ "include": "#classPubDecls" },
    	{ "include": "#flags" },
		{ "include": "#assignOprs" },
		{ "include": "#arithOprss" },
		{ "include": "#bitewiseOprs" },
		{ "include": "#logicOprs" },
		{ "include": "#compOprs" },
		{ "include": "#threeWayCompOprs" },
		{ "include": "#rangeOprs" },
		{ "include": "#pointerOprs" },
		{ "include": "#primitiveFuncs" },
		{ "include": "#identifiers" }
  	],
  	"repository": {
		"imports": {
			"begin": "\\b(lo)",
    	  	"beginCaptures": {
    	  	  	"1": { "name": "keyword.control.directive.kui" }
    	  	},
    	  	"end": ";|$",
    	  	"patterns": [
				{
    	  	  	  "name": "entity.name.function.kui",
				  "match": "\\b([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)\\b"
    	  	  	}
    	  	]
		},

		"mods": {
			"begin": "\\b(mú)",
    	  	"beginCaptures": {
    	  	  	"1": { "name": "keyword.control.directive.kui" }
    	  	},
    	  	"end": ";|$",
    	  	"patterns": [
				{
    	  	  	  "name": "keyword.control.kui",
				  "match": "\\b(gẹ́gẹ́bíi)\\b"
    	  	  	},
				{
    	  	  	  "name": "",
				  "match": "\\b([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)\\b"
    	  	  	},
				
				{
    	  	  	  "include": "#strings"
    	  	  	}
    	  	]
		},

		"modEntries": {
		  	"patterns": [
		  		{
    	      	  "name": "storage.type.kui",
    	      	  "match": "\\b(lo|mú)\\b\\s*;"
    	      	}
		  	]
		},

    	"comments": {
    	  "patterns": [
    	    { "name": "comment.line.double-slash.kui", "match": "//.*$" },
    	    {
    	      "name": "comment.block.kui",
    	      "begin": "/\\*",
    	      "end": "\\*/",
    	      "patterns": [{ "include": "#comments" }]
    	    }
    	  ]
    	},
    	"strings": {
    	  	"patterns": [
    	  	  	{ "name": "string.quoted.triple.kui", "begin": "`", "end": "`"},
    	  	  	{ "name": "string.quoted.double.kui", "begin": "\"", "end": "\"", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.kui" }]},
    	  	  	{ "name": "string.quoted.single.kui", "begin": "'", "end": "'", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.kui" }]}
    	  	]
    	},

    	"numbers": {
    	  	"patterns": [
    	  	  	{ "name": "constant.numeric.kui", "match": "\\b(0x[0-9A-Fa-f]+|\\d+(?:\\.\\d+)?)\\b" }
    	  	]
    	},

		"enumDecls": {
			"begin": "\\b(apẹ̀tẹ̀)\\s+([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)",
    	  	"beginCaptures": {
    	  	  	"1": { "name": "storage.type.enum.kui" },
    	  	  	"2": { "name": "entity.name.type.enum.kui" } 
    	  	},
    	  	"end": "}",
    	  	"patterns": [
				{
    	  	  	  "include": "#comments"
    	  	  	},
				{
    	  	  	  "include": "#flags"
    	  	  	},
    	  	  	{
    	  	  	  "include": "#enumBody"
    	  	  	},
				{
    	  	  	  "include": "#types"
    	  	  	}
    	  	]
    	},

    	"enumBody": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"match": "\\b([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)\\b",
    	  	  	  	"name": "variable.other.enummember.kui"
    	  	  	}
    	  	]
    	},

    	"declKeywords": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "storage.type.kui",
    	  	  	  	"match": "\\b(itú|ojúlèéjà|apẹ̀tẹ̀|ẹpín|àtagbá|òǹdẹ|ìdì)\\b"
    	  	  	}
    	  	]
    	},

    	"classPubDecls": {
		  	"patterns": [
		  		{
    	      	  "name": "storage.type.kui",
    	      	  "match": "\\b(gbangba|àdáni)\\b\\s*;"
    	      	}
		  	]
		},

		"specKeywords": {
		  	"patterns": [
		  		{
    	      	  	"name": "variable.language.this.kui",
    	      	  	"match": "\\b(èyí|nínún)\\b"
    	      	}
		  	]
		},

		"primitiveFuncs": {
			"patterns": [
    	  	  	{
    	  	  	  	"name": "support.function.kui",
    	  	  	  	"match": "\\b(òǹsọ|òǹgbọ́|pẹ̀lú)\\b"
    	  	  	}
			]
		},

    	"keywords": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.control.kui",
    	  	  	  	"match": "\\b(gẹ́gẹ́bíi|pitú|kí|yí|pòrì|tí|ṣe|ṣé|fún|pàrọ̀|ibá|já|àìjẹ́bẹ̀|padà|nínún|di)\\b"
    	  	  	}
    	  	]
    	},

    	"types": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "support.type.kui",
    	  	  	  	"match": "\\b(8m|16m|32m|64m|128m|ìtó_m|8p|16p|32p|64p|128p|ìtó_p|8b|16b|32b|64b|128b|ìtó_b|àkàyọ|ọsán|bulì|ohun)\\b"
    	  	  	}
    	  	]
    	},

		"boolLiterals": {
			"patterns": [
    	  	  	{
    	  	  	  	"name": "constant.language.boolean.kui markup.italic.kui",
    	  	  	  	"match": "\\b(òtítọ́|irọ́)\\b"
    	  	  	}
    	  	]
		},

		"classIdentifiers": {
			"begin": "\\b(ẹpín)\\b\\s+(\\b([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)\\b)",
    	  	"beginCaptures": {
    	  	  	"1": { "name": "storage.type.enum.kui" },
				"2": { "name": "entity.name.class.kui" }
    	  	},
    	  	"end": "\\s"
    	  	
		},

    	"funcIdentifiers": {
			"patterns": [
    	  	  	{
    	  	    	"name": "entity.name.function.kui",
    	  	    	"match": "\\b[\\p{L}_][\\p{L}\\p{M}\\p{N}_]*\\b(\\s*\\()"
    	  	  	}
    	  	]
    	},

		"macros": {
			"begin": "(#)",
    	  	"beginCaptures": {
    	  	  	"1": { "name": "keyword.control.directive.kui" }
    	  	},
    	  	"end": "\\(|;|$",
			"patterns": [
				{
    	  	    	"name": "entity.name.function.preprocessor.kui",
    	  	    	"match": "\\b[\\p{L}_][\\p{L}\\p{M}\\p{N}_]*\\b"
    	  	  	},
    	  	  	{
    	  	    	"name": "",
    	  	    	"match": "\\s*"
    	  	  	}
    	  	]
    	},

		"identifiers": {
			"patterns": [
    	  		{
    	  	    	"name": "variable.other.kui",
    	  	    	"match": "\\b[\\p{L}_][\\p{L}\\p{M}\\p{N}_]*\\b"
    	  		}
    	  	]
    	},

		"flags": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.control.directive.kui markup.italic.kui",
    	  	  	  	"match": "(òde|pìkí|gbangba)"
    	  	  	}
    	  	]
    	},

    	"assignOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.assignment.kui",
    	  	  	  	"match": "(\\+=|-=|\\*=)"
    	  	  	}
    	  	]
    	},
		"arithOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.arithmetic.kui",
    	  	  	  	"match": "(\\+|-|\\*|/|%)"
    	  	  	}
    	  	]
    	},
		"bitwiseOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.bitwise.kui",
    	  	  	  	"match": "(&|\\||^|~|<<|>>)"
    	  	  	}
    	  	]
    	},
		"logicOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.logical.kui",
    	  	  	  	"match": "(&&|\\|\\||!)"
    	  	  	}
    	  	]
    	},
		"compOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.comparison.kui",
    	  	  	  	"match": "(=|!=|<|>|<=|>=)"
    	  	  	}
    	  	]
    	},
		"threeWayCompOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.spaceship.kui",
    	  	  	  	"match": "(<=>)"
    	  	  	}
    	  	]
    	},
		"rangeOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.range.kui",
    	  	  	  	"match": "(\\.\\.\\.)"
    	  	  	}
    	  	]
    	},
		"pointerOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.pointer.kui",
    	  	  	  	"match": "(#|@)"
    	  	  	}
    	  	]
    	}
  	}
}

