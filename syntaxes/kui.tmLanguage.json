{
  	"scopeName": "source.kui",
  	"name": "Kui",
  	"fileTypes": ["kui"],
  	"patterns": [
		{ "include": "#funcCustomTypes" },
		{ "include": "#funcCustomTypes2" },
		{ "include": "#modEntries" },
		{ "include": "#documentations" },
    	{ "include": "#comments" },
    	{ "include": "#strings" },
    	{ "include": "#numbers" },
		{ "include": "#importAs" },
		{ "include": "#identPublic" },
		{ "include": "#publicAs" },
    	{ "include": "#flags" },
		{ "include": "#macroDecls" },
		{ "include": "#typeVariant" },
    	{ "include": "#conFlowKeywords" },
	  	{ "include": "#specKeywords" },
    	{ "include": "#types" },
		{ "include": "#boolLiterals" },
		{ "include": "#enumDecls" },
		{ "include": "#enumValType" },
		{ "include": "#structDecls" },
		{ "include": "#typeDecls" },
	  	{ "include": "#declKeywords" },
		{ "include": "#varKeywords" },
		{ "include": "#tyIdentifiers" },
		{ "include": "#macros" },
		{ "include": "#funcTypeIdents" },
		{ "include": "#TypeIdents" },
	  	{ "include": "#funcIdentifiers" },
		{ "include": "#storageKeywords" },
		{ "include": "#assignOprs" },
		{ "include": "#arithOprss" },
		{ "include": "#bitewiseOprs" },
		{ "include": "#logicOprs" },
		{ "include": "#compOprs" },
		{ "include": "#threeWayCompOprs" },
		{ "include": "#rangeOprs" },
		{ "include": "#pointerOprs" },
		{ "include": "#commands" },
		{ "include": "#identifiers" }
  	],
  	"repository": {
		"modEntries": {
		  	"patterns": [
		  		{
    	      	  	"name": "keyword.control.import.kui",
    	      	  	"match": "\\b(lo|mú)\\b"
    	      	}
		  	]
		},

		"importAs": {
			"match": "\\b([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)\\s+(nípè)",
    	  	"captures": {
    	  	  	"1": { "name": "variable.other.kui" },
    	  	  	"2": { "name": "keyword.control.import.kui" }
    	  	}
    	},

		"publicAs": {
			"match": "\\b([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)\\s+(gbangba)\\s+(nípè)",
    	  	"captures": {
    	  	  	"1": { "name": "variable.other.kui" },
				"2": { "name": "markup.italic.kui keyword.other.kui" },
    	  	  	"3": { "name": "keyword.control.import.kui" }
    	  	}
    	},

		"identPublic": {
			"match": "\\b([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)\\s+(gbangba)",
    	  	"captures": {
    	  	  	"1": { "name": "variable.other.kui" },
    	  	  	"2": { "name": "markup.italic.kui keyword.other.kui" }
    	  	}
    	},

    	"comments": {
    	  "patterns": [
    	    { "name": "comment.line.double-slash.kui", "match": "//.*$" },
    	    {
    	      "name": "comment.block.kui",
    	      "begin": "/\\*",
    	      "end": "\\*/",
    	      "patterns": [{ "include": "#comments" }]
    	    }
    	  ]
    	},

		"documentations": {
    	  "patterns": [
    	    { "name": "markup.bold.kui comment.line.double-slash.kui", "match": ";.*$" },
    	    {
				"name": "markup.italic.kui string.quoted.double.kui",
				"begin": "\"\"\"", "end": "\"\"\"", "patterns": [
					{ "match": "\\\\.", "name": "markup.italic.kui constant.character.escape.kui" }
				]
			}
    	  ]
    	},
		
    	"strings": {
    	  	"patterns": [
				{ "name": "string.quoted.single.kui", "begin": "`", "end": "`", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.kui" }]},
    	  	  	{ "name": "string.quoted.double.kui", "begin": "\"", "end": "\"", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.kui" }]},
    	  	  	{ "name": "string.quoted.single.kui", "begin": "'", "end": "'", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.kui" }]}
    	  	]
    	},

    	"numbers": {
    	  	"patterns": [
    	  	  	{ "name": "constant.numeric.kui", "match": "\\b(0x[0-9A-Fa-f]+|\\d+(?:\\.\\d+)?)\\b" }
    	  	]
    	},

		"enumDecls": {
			"match": "\\b(apẹ̀rẹ̀)\\s+([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)",
    	  	"captures": {
    	  	  	"1": { "name": "storage.type.kui" },
    	  	  	"2": { "name": "entity.name.type.kui" }
    	  	}
    	},

		"enumValType": {
			"match": "\\b([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)\\s+(::)",
    	  	"captures": {
    	  	  	"1": { "name": "entity.name.type.kui" }
    	  	}
    	},

		"structDecls": {
			"match": "\\b(ìrísí)\\s+([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)",
    	  	"captures": {
    	  	  	"1": { "name": "storage.type.kui" },
    	  	  	"2": { "name": "entity.name.type.kui" }
    	  	}
    	},

		"TypeIdents": {
			"match": "([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)\\s+([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)",
    	  	"captures": {
    	  	  	"1": { "name": "entity.name.type.kui" },
    	  	  	"2": { "name": "variable.other.kui" }
    	  	}
    	},

		"funcTypeIdents": {
			"match": "([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)\\s+([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)\\s*(\\()",
    	  	"captures": {
    	  	  	"1": { "name": "entity.name.type.kui" },
    	  	  	"2": { "name": "entity.name.function.kui" }
    	  	}
    	},

		"typeDecls": {
			"begin": "\\b(afárá)",
    	  	"beginCaptures": {
    	  	  	"1": { "name": "keyword.other.kui" }
    	  	},
    	  	"end": "$|\\{|kárí|mú|lo|afárá|apẹ̀rẹ̀|ìrísí|itú|ìríjú|kékeré|túmọ̀|ogún|#",
    	  	"patterns": [
				{
    	  	  	  	"name": "keyword.control.kui",
    	  	  	  	"match": "\\b(ṣe)\\b"
    	  	  	},
				{
    	  	  	  	"include": "#specKeywords"
    	  	  	},
				{
					"include": "#types"
				},
				{
					"include": "#flags"
				},
				{
    	  	  	  "include": "#newType"
    	  	  	},
				{
					"include": "#identifiers"
				},
				{
					"include": "#comments"
				}
    	  	]
    	},

		"newType": {
			"patterns": [
    	  	  	{
    	  	  	  	"match": "(sí)\\s+(\\b([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)\\b)",
					"captures": {
						"1": { "name": "storage.type.kui" },
						"2": { "name": "entity.name.type.kui"}
					}
				}
			]
		},

		"typeVariant": {
			"match": "([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)s*\\{",
    	  	"captures": {
    	  	  	"1": { "name": "entity.name.function.kui" }
    	  	}
    	},

		"storageKeywords": {
			"comments": "storage.type.enum.kui, keyword.other.kui",
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "storage.type.kui",
    	  	  	  	"match": "\\b(ìrísí|apẹ̀rẹ̀)\\b"
    	  	  	}
    	  	]
    	},
		
		"declKeywords": {
			"comments": "storage.type.kui",
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.other.kui",
    	  	  	  	"match": "\\b(itú|afárá|túmọ̀|pẹpẹ|òṣìṣẹ́|àfijọ|kékeré|adágún)\\b"
    	  	  	}
    	  	]
    	},

		"varKeywords": {
			"comments": "storage.type.kui",
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "markup.italic.kui keyword.declaration.kui",
    	  	  	  	"match": "\\b(kárí|kí|ní|pitú)\\b"
    	  	  	}
    	  	]
    	},

		"specKeywords": {
		  	"patterns": [
		  		{
    	      	  	"name": "variable.language.self.kui",
    	      	  	"match": "\\b(òwun|àbájáde)\\b"
    	      	}
		  	]
		},

		"commands": {
			"patterns": [
    	  	  	{
    	  	  	  	"name": "markup.italic.kui storage.type.kui",
    	  	  	  	"match": "\\b(padà|tẹ̀síwájú|já|ré)\\b"
    	  	  	}
			]
		},

    	"conFlowKeywords": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.control.kui",
    	  	  	  	"match": "\\b(nípè|dúróde|bẹ̀rẹ̀|yí|kó|pòrì|tí|àìjẹ́bẹ̀|ṣe|sí|fún|gbìyànjú|hán|ju|látinú|jọmọ́|níwọ̀bí|níbàámu|wo|jogún|tàṣé|máa_ṣa)\\b"
    	  	  	}
    	  	]
    	},

    	"types": {
			"comment": "entity.name.type.kui, for custom types, support.type.kui for primitives",
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "support.type.kui",
    	  	  	  	"match": "\\b(8d|16d|32d|64d|128d|àtó_d|8p|16p|32p|64p|128p|àtó_p|8b|16b|32b|64b|128b|àtó_b|wóró|ọsán|ǹjẹ́|ibùta|itùrin|òfìfo|àṣàyàn|àyọrísí)\\b"
    	  	  	}
    	  	]
    	},

		"boolLiterals": {
			"patterns": [
    	  	  	{
    	  	  	  	"name": "markup.italic.kui constant.language.boolean.kui",
    	  	  	  	"match": "\\b(òtítọ́|irọ́|bóyá|agbede|àìwí|x86_64|arm|windows|linux|mac)\\b"
    	  	  	}
    	  	]
		},

    	"funcIdentifiers": {
			"patterns": [
    	  	  	{
    	  	    	"name": "entity.name.function.kui",
    	  	    	"match": "\\b[\\p{L}_][\\p{L}\\p{M}\\p{N}_]*\\b(\\s*\\()"
    	  	  	}
    	  	]
    	},

		"macroDecls": {
			"match": "\\b(kékeré)\\s+([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)",
    	  	"captures": {
    	  	  	"1": { "name": "storage.type.enum.kui" },
    	  	  	"2": { "name": "entity.name.function.kui" }
    	  	}
    	},

		"macros": {
			"patterns": [
				{
    	  	    	"name": "entity.name.function.preprocessor.kui",
    	  	    	"match": "(#)\\b[\\p{L}_][\\p{L}\\p{M}\\p{N}_]*\\b"
    	  	  	}
			]
    	},

		"identifiers": {
			"patterns": [
    	  		{
    	  	    	"name": "variable.other.kui",
    	  	    	"match": "\\b[\\p{L}_][\\p{L}\\p{M}\\p{N}_]*\\b"
    	  		}
    	  	]
    	},

		"flags": {
			"comment": "keyword.operator.kui, keyword.control.directive.kui",
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "markup.italic.kui keyword.other.kui",
    	  	  	  	"match": "(hàn|gbangba|látòde|tóyí)"
    	  	  	}
    	  	]
    	},

    	"assignOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.assignment.kui",
    	  	  	  	"match": "(\\+=|-=|\\*=)"
    	  	  	}
    	  	]
    	},
		"arithOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.arithmetic.kui",
    	  	  	  	"match": "(\\+|-|\\*|/|%)"
    	  	  	}
    	  	]
    	},
		"bitwiseOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.bitwise.kui",
    	  	  	  	"match": "(\\^|~|<<|>>)"
    	  	  	}
    	  	]
    	},
		"logicOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.Reference.kui",
    	  	  	  	"match": "(&|\\*|\\||!)"
    	  	  	}
    	  	]
    	},
		"compOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.comparison.kui",
    	  	  	  	"match": "(=|!=|<|>|<=|>=)"
    	  	  	}
    	  	]
    	},
		"threeWayCompOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.spaceship.kui",
    	  	  	  	"match": "(<=>)"
    	  	  	}
    	  	]
    	},
		"rangeOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.range.kui",
    	  	  	  	"match": "(\\.\\.\\.)"
    	  	  	}
    	  	]
    	},
		"pointerOprs": {
    	  	"patterns": [
    	  	  	{
    	  	  	  	"name": "keyword.operator.pointer.kui",
    	  	  	  	"match": "(#|@)"
    	  	  	}
    	  	]
    	}
  	}
}

