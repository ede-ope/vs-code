{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["?:", "?"],
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "?:", "close": "?" }
  ],
  "surroundingPairs": [
    ["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"], ["?:", "?"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^(.*\\b(kí|yí|sọ||àtiṣe|ìpín|ẹ̀wun|apẹ̀tẹ̀|àkànto|ṣe|ṣé|pòòrì|tí)\\b.*|.*\\{[^\\}]*$)",
    "decreaseIndentPattern": "^\\s*\\}"
  }
}
