{
  	"name": "ope-language",
  	"displayName": "Ope",
  	"description": "Ope language support — syntax highlighting and basic IntelliSense.",
  	"version": "0.2.0",
  	"publisher": "you",
  	"license": "MIT",
  	"engines": { "vscode": "^1.70.0" },
  	"activationEvents": ["onLanguage:ope"],
  	"main": "./extension.js",
  	"contributes": {
  	  	"languages": [
  	  	  	{
  	  	  	  	"id": "ope",
  	  	  	  	"aliases": ["Ope", "ope"],
  	  	  	  	"extensions": [".ope"],
  	  	  	  	"configuration": "./language-configuration.json"
  	  	  	}
  	  	],
  	  	"grammars": [
  	  	  	{
  	  	  	  	"language": "ope",
  	  	  	  	"scopeName": "source.ope",
  	  	  	  	"path": "./syntaxes/ope.tmLanguage.json"
  	  	  	}
  	  	],
  	  	"configurationDefaults": {
  	  	  	"[ope]": {
  	  	  	  	"editor.wordBasedSuggestions": false,
  	  	  	  	"editor.suggest.showSnippets": false
  	  	  	}
  	  	}
  	}
}
